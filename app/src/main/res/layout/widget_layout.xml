<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="142dp"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp"
    android:gravity="center">

    <!-- ZONA SUPERIOR: Click → Abre la app -->
    <LinearLayout
        android:id="@+id/zona_abrir_app"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/tv_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CTE Ernesto Guevara"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_carga1"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="-"
                android:textColor="#1976D2"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/circulo_blanco"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/tv_carga2"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="-"
                android:textColor="#1976D2"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/circulo_blanco"
                android:layout_marginHorizontal="16dp"/>

            <TextView
                android:id="@+id/tv_carga3"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="-"
                android:textColor="#1976D2"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/circulo_blanco"
                android:layout_marginHorizontal="16dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ZONA INFERIOR: Click → Actualizar widget -->
    <LinearLayout
        android:id="@+id/btn_actualizar_zona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/tv_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

        <LinearLayout
            android:id="@+id/btn_actualizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false"
            android:layout_marginStart="24dp"
            android:background="@android:color/transparent">

            <ProgressBar
                android:id="@+id/spinner"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:visibility="gone"
                android:indeterminateTint="#FFFFFF"/>

            <TextView
                android:id="@+id/icono_actualizar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⟳"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/tv_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>