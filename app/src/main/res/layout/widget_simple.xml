<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_simple_root"
    android:layout_width="230dp"
    android:layout_height="150dp"
    android:background="@drawable/widget_simple_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="334dp"
        android:layout_height="100dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="87dp"
            android:layout_height="100dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/widget_logo_background"
            android:scaleType="centerCrop"
            android:src="@drawable/che_guevara" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_unidad1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Un.1: -"
                android:textColor="#1565C0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_unidad2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Un.2: -"
                android:textColor="#1565C0"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_unidad3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Un.3: -"
                android:textColor="#1565C0"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="203dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="#1565C0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/icono_actualizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:text="⟳"
            android:textColor="#1565C0"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/spinner_icono"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="2dp"
            android:indeterminateTint="#1565C0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar"
            android:textColor="#1565C0"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/circulo_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:src="@drawable/circulo_rojo"
            android:visibility="invisible" />

    </LinearLayout>

</LinearLayout>